# Шаблон настроек. Скопируйте в `.env` и заполните своими значениями:
#   cp .env.example .env
# Файл `.env` в репозиторий не попадает (см. .gitignore). Не вписывайте настоящие ключи сюда.

# --- База данных ---
# Либо задайте DATABASE_URL целиком, либо оставьте его пустым: тогда адрес соберётся из POSTGRES_*.
DATABASE_URL=
POSTGRES_USER=suppliers
POSTGRES_PASSWORD=change-me
POSTGRES_DB=suppliers
# db — имя сервиса в Docker Compose; при запуске без Docker укажите localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Веб ---
# Порт, на котором приложение открывается на вашей машине (по умолчанию 8088).
WEB_PORT=8088
# Для HTTPS на сервере: SITE_ADDRESS=ваш.домен (Caddy сам получит сертификат). По умолчанию :80.
# SITE_ADDRESS=
# Вход по логину и паролю (на сервере обязательно). Хеш пароля: python3 backend/scripts/hash_password.py 'ПАРОЛЬ'
# (подробности в README, раздел «Развернуть на своём сервере»); в .env вставьте его в одинарных кавычках.
# Хеш пустой или не задан: вход отключён (удобно только на своём компьютере).
# AUTH_USER=admin
# AUTH_PASSWORD_HASH=
# Только для docker-compose.prod.yml (сервер с готовым обратным прокси): имя Docker-сети прокси и тег образов.
# PROXY_NETWORK=
# IMAGE_TAG=latest

# --- Yandex Cloud ---
# Один каталог (folder) Yandex Cloud для AI Studio и Search API.
YANDEX_CLOUD_FOLDER_ID=

# --- LLM, OpenAI-совместимый API (Yandex AI Studio) ---
# Адрес указан по документации Yandex AI Studio (быстрый старт); при сомнениях сверьте с ней.
# LLM_MODEL: идентификатор модели из списка в консоли Yandex AI Studio в виде <модель>/<версия>.
# Префикс gpt://<YANDEX_CLOUD_FOLDER_ID>/ скрипт добавит сам; можно указать и полный URI.
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_API_KEY=
LLM_MODEL=

# --- GigaChat (участвует в проверке моделей) ---
# GIGACHAT_CREDENTIALS — «Ключ авторизации» из личного кабинета (уже в формате Base64).
# Серверы GigaChat подписаны сертификатами НУЦ Минцифры, которым Python по умолчанию не доверяет:
# GIGACHAT_CA_BUNDLE — путь к PEM-файлу с этими сертификатами.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_CA_BUNDLE=certs/russian_trusted_ca.pem

# --- Поиск ---
# Если не задан, используется LLM_API_KEY (тот же ключ Yandex Cloud, проверено)
YANDEX_SEARCH_API_KEY=
DGIS_API_KEY=

# --- Обход сайта-источника каталога ---
CRAWL_DELAY_SECONDS=1.0
CRAWL_USER_AGENT=goulash-suppliers-test/0.1 (test assignment)

# --- Ограничения запуска агента (деньги и время); значения по умолчанию заданы в коде ---
# AGENT_MAX_TURNS=24
# AGENT_MAX_SECONDS=600
# AGENT_MAX_TOTAL_TOKENS=200000   # вместе с токенами, потраченными внутри изучения сайтов
# AGENT_TARGET_SUPPLIERS=5
# AGENT_MAX_FETCHES=70
# LLM_PRICE_PER_1K_TOKENS_RUB=1.2     # тариф для оценки стоимости (YandexGPT Pro 5; Pro 5.1 — 0.8)
# SEARCH_PRICE_PER_REQUEST_RUB=0.488  # Search API v2, дневной тариф
# AGENT_MAX_PRODUCTS_PER_SEARCH=3   # товаров в одном поиске: каждый товар — отдельный платный запуск
# AGENT_MAX_RUNS_PER_DAY=10   # суточный лимит запусков (запуск платный; защита публичного стенда)
